# Server
NODE_ENV=development
PORT=4000
# Worker health server port (local only — on a host, leave unset and the worker binds PORT)
WORKER_PORT=4001
CLIENT_URL=http://localhost:5173

# Databases (see ../docker-compose.yml)
MONGO_URI=mongodb://localhost:27017/northcut?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# Logging: error | warn | info | http | debug
LOG_LEVEL=debug

# Auth — generate the secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

# Orders — how long an unpaid order holds its stock, and the flat shipping fee in kobo
ORDER_HOLD_MINUTES=30
SHIPPING_FEE_KOBO=0

# Payments — "mock" is the only provider until a real one is chosen (plan.md §9).
# The secret signs/verifies webhooks; generate one like JWT_ACCESS_SECRET.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-string-of-at-least-16-characters
# The mock gateway is always on in development. In production (NODE_ENV=production) it's off unless
# this is "true" — e.g. a deployed demo before a real gateway exists. Remove once one is added.
ALLOW_MOCK_PAYMENTS=false
# Public URL of this API (webhooks are sent here). Defaults to http://localhost:$PORT.
# API_URL=

# Cloudinary (product images) — from the Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=northcut
